{
  "expo": {
    "name": "GMM",
    "slug": "gmm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/logo.png",
    "scheme": "gmm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gmm.marketmanager",
      "icon": "./assets/images/logos/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logos/logo.png",
        "backgroundColor": "#f0f9f8"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gmm.marketmanager",
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logos/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f0f9f8",
          "image": "./assets/images/logos/logo.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-document-picker",
      "expo-notifications"
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}
